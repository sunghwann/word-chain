rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 랭킹: 누구나 읽고, 자기 기록만 씀
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.nick is string
                   && request.resource.data.nick.size() <= 12;
    }

    // 1:1 대결 방
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && (
                       resource.data.host == request.auth.uid ||
                       resource.data.guest == request.auth.uid ||
                       (resource.data.guest == null && request.resource.data.guest == request.auth.uid));
      allow delete: if false;
    }
  }
}
