rules_version = '2';
// 버전: 2026-11-10 v6 (차단 목록)
service cloud.firestore {
  match /databases/{database}/documents {

    // 차단 목록: Firebase 콘솔에서 bans/{uid} 문서를 만들면 그 사람은 기록·방을 쓸 수 없음
    function notBanned() { return !exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    function signedIn() { return request.auth != null && notBanned(); }
    function me() { return request.auth.uid; }

    /* ---------------- 랭킹 ----------------
       기록 문서는 항상 이 모양 그대로 저장함:
       { nick, easy:{best,sum,w,l}, mid:{…}, hard:{…}, pvp:{w,l}, total, updatedAt, (lastClaim) } */

    function lvOk(m, cap) {
      return m.keys().hasOnly(['best', 'sum', 'w', 'l'])
        && m.best is int && m.sum is int && m.w is int && m.l is int
        && m.best >= 0 && m.best <= cap && m.sum >= 0 && m.w >= 0 && m.l >= 0;
    }
    function shapeOk(n) {
      return n.keys().hasOnly(['nick', 'easy', 'mid', 'hard', 'pvp', 'total', 'updatedAt', 'lastClaim'])
        && n.keys().hasAll(['nick', 'easy', 'mid', 'hard', 'pvp', 'total', 'updatedAt'])
        && n.nick is string && n.nick.size() <= 12
        && lvOk(n.easy, 1500) && lvOk(n.mid, 3000) && lvOk(n.hard, 4500)
        && n.pvp.keys().hasOnly(['w', 'l']) && n.pvp.w is int && n.pvp.l is int
        && n.total == n.easy.sum + n.mid.sum + n.hard.sum
        && n.updatedAt == request.time;
    }
    // 처음 만드는 기록은 모두 0에서 시작한 것으로 봄
    function blank() {
      return {'easy': {'best': 0, 'sum': 0, 'w': 0, 'l': 0}, 'mid': {'best': 0, 'sum': 0, 'w': 0, 'l': 0},
              'hard': {'best': 0, 'sum': 0, 'w': 0, 'l': 0}, 'pvp': {'w': 0, 'l': 0}};
    }

    // 1) 닉네임만 바꿈 (5초에 한 번)
    function nickOnly(n, o) {
      return n.easy == o.easy && n.mid == o.mid && n.hard == o.hard && n.pvp == o.pvp
        && (!('updatedAt' in o) || request.time > o.updatedAt + duration.value(5, 's'));
    }

    // 2) 컴퓨터 대결 한 판: 시작 기록(세션)을 이번 쓰기에서 지워야 하고,
    //    이번 판 점수는 걸린 시간 비례 상한(단어 1개당 최소 1.5초)과 난이도별 상한을 넘을 수 없음
    function sessionPath() { return /databases/$(database)/documents/sessions/$(me()); }
    function capOk(g, L, secs) {
      return (L == 'easy' && g <= 1500 && g * 3 <= 90  + 20 * secs)
          || (L == 'mid'  && g <= 3000 && g * 3 <= 300 + 40 * secs)
          || (L == 'hard' && g <= 4500 && g * 3 <= 750 + 60 * secs);
    }
    function levelGame(nl, ol, L, secs) {
      let g = nl.sum - ol.sum;
      return nl.w >= ol.w && nl.l >= ol.l && nl.w + nl.l == ol.w + ol.l + 1
        && g >= 0 && capOk(g, L, secs)
        && ((g > ol.best && nl.best == g) || (g <= ol.best && nl.best == ol.best));
    }
    function soloGame(n, o) {
      let s = get(sessionPath()).data;
      return exists(sessionPath()) && !existsAfter(sessionPath())
        && n.pvp == o.pvp
        && (s.level == 'easy' || n.easy == o.easy)
        && (s.level == 'mid'  || n.mid  == o.mid)
        && (s.level == 'hard' || n.hard == o.hard)
        && levelGame(n[s.level], o[s.level], s.level, (request.time - s.startedAt).seconds());
    }

    // 3) 1:1 결과: 승리는 실제로 이긴 방의 증빙(claim)을 이번 쓰기에서 함께 만들어야 함
    function claimPath(id) { return /databases/$(database)/documents/claims/$(id); }
    function pvpResult(n, o) {
      return n.easy == o.easy && n.mid == o.mid && n.hard == o.hard
        && (
          (n.pvp.w == o.pvp.w + 1 && n.pvp.l == o.pvp.l
            && n.lastClaim is string
            && !exists(claimPath(n.lastClaim)) && existsAfter(claimPath(n.lastClaim))
            && getAfter(claimPath(n.lastClaim)).data.uid == me())
          || (n.pvp.w == o.pvp.w && n.pvp.l == o.pvp.l + 1)
        );
    }

    function okWrite(n, o) {
      return shapeOk(n) && (nickOnly(n, o) || soloGame(n, o) || pvpResult(n, o));
    }

    match /bans/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /scores/{uid} {
      allow read: if true;
      allow create: if signedIn() && uid == me() && okWrite(request.resource.data, blank());
      allow update: if signedIn() && uid == me() && okWrite(request.resource.data, resource.data);
    }

    // 컴퓨터 대결 시작 기록 (본인만)
    match /sessions/{uid} {
      allow read, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['level', 'startedAt'])
        && request.resource.data.level in ['easy', 'mid', 'hard']
        && request.resource.data.startedAt == request.time;
    }

    // 1:1 승리 증빙: 방 결과가 내 승리일 때만, 방·회차당 한 번
    match /claims/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['code', 'round', 'uid'])
        && request.resource.data.uid == me()
        && request.resource.data.round is int
        && id == request.resource.data.code + '_' + string(request.resource.data.round) + '_' + me()
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.code)).data.status == 'done'
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.code)).data.winner == me()
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.code)).data.round == request.resource.data.round;
    }


    /* ---------------- 1:1 대결 방 ---------------- */
    // 방 만들기 속도 제한: 30초에 한 번
    match /limits/{uid} {
      allow read: if signedIn() && uid == me();
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['lastRoomAt'])
        && request.resource.data.lastRoomAt == request.time;
      allow update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['lastRoomAt'])
        && request.resource.data.lastRoomAt == request.time
        && request.time > resource.data.lastRoomAt + duration.value(30, 's');
    }

    function roomKeys() {
      return ['code', 'host', 'hostNick', 'guest', 'guestNick', 'status', 'round', 'words',
              'turn', 'turnStart', 'pending', 'winner', 'reason', 'acc', 'createdAt'];
    }
    function lastWordOk(ws) {
      return ws.size() == 0 || (ws[ws.size() - 1].w is string && ws[ws.size() - 1].w.size() <= 12);
    }

    match /rooms/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(roomKeys())
        && request.resource.data.code == code
        && request.resource.data.host == me()
        && request.resource.data.hostNick is string && request.resource.data.hostNick.size() <= 12
        && request.resource.data.guest == null
        && request.resource.data.status == 'waiting'
        && request.resource.data.words.size() == 0
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/limits/$(me())).data.lastRoomAt == request.time;

      allow update: if signedIn()
        && (resource.data.host == me() || resource.data.guest == me() || resource.data.guest == null)
        && request.resource.data.keys().hasOnly(roomKeys())
        && request.resource.data.host == resource.data.host
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['waiting', 'playing', 'done']
        && request.resource.data.words is list
        && request.resource.data.words.size() <= 400
        && (request.resource.data.words.size() == resource.data.words.size()
            || request.resource.data.words.size() == resource.data.words.size() + 1
            || request.resource.data.words.size() == 1)
        && lastWordOk(request.resource.data.words)
        && ((resource.data.guest == null
             && request.resource.data.guest == me()
             && request.resource.data.guestNick is string && request.resource.data.guestNick.size() <= 12)
            || (resource.data.guest != null
             && request.resource.data.guest == resource.data.guest
             && request.resource.data.guestNick == resource.data.guestNick))
        && (request.resource.data.winner == null
            || request.resource.data.winner == request.resource.data.host
            || request.resource.data.winner == request.resource.data.guest)
        && (request.resource.data.turn == null
            || request.resource.data.turn == request.resource.data.host
            || request.resource.data.turn == request.resource.data.guest);

      allow delete: if false;
    }
  }
}
